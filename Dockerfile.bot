# .dockerignore recommendation: add the following entries to .dockerignore
# .env*
# node_modules/
# .next/
# public/
# src/
# tests/
# *.log

FROM node:22-alpine

WORKDIR /app

COPY package.json package-lock.json ./

RUN npm ci --omit=dev && npm install --no-save tsx

COPY scripts/ ./scripts/
COPY tsconfig.json ./

HEALTHCHECK NONE

CMD ["node_modules/.bin/tsx", "scripts/telegram-bot.ts"]
