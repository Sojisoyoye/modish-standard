# .env.example — copy to .env.local and fill in values

# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=your_sanity_api_token_here

# Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name

# WhatsApp
NEXT_PUBLIC_WHATSAPP_NUMBER=2348XXXXXXXXX

# Site
NEXT_PUBLIC_SITE_URL=https://www.modishstandard.com

# Analytics (add after launch)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Docker (optional — override host port)
# PORT=3100

# Vercel (set as GitHub Secrets, not .env)
# VERCEL_TOKEN=
# VERCEL_ORG_ID=
# VERCEL_PROJECT_ID=

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_AUTHORIZED_USER_IDS=123456789  # comma-separated Telegram user IDs

# Inventory App
INVENTORY_APP_URL=https://pos.virtualrx.com.ng
INVENTORY_APP_USERNAME=
INVENTORY_APP_PASSWORD=

# n8n (Workflow J — POS stock → Airtable → content pipeline)
# Get this URL from the Webhook trigger node in Workflow J at n8n.modishstandard.com
N8N_STOCKSYNC_WEBHOOK_URL=https://n8n.modishstandard.com/webhook/your-path-here
